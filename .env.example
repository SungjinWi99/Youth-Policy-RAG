# 온통청년 Open API 인증키
YOUTH_API_KEY=

# Gemini
GEMINI_API_KEY=

# Upstage
UPSTAGE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# LangFeather tracing. Enabled by default; set to false to disable (e.g. no
# collector available). 127.0.0.1:4319 works both for a local `docker run`
# collector and for Docker Compose (the langfeather container shares the
# api container's network namespace — see compose.yaml).
LANGFEATHER_TRACING=true
LANGFEATHER_ENDPOINT=http://127.0.0.1:4319

# 로컬 HTTP에서는 false, EC2 HTTPS 배포에서는 true
SESSION_COOKIE_SECURE=false
