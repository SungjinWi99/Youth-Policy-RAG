# ECR image repository. Do not include a tag here.
ECR_REPOSITORY=605855662890.dkr.ecr.ap-northeast-2.amazonaws.com/wiggle/youth-policy-rag

# Persistent EBS-backed application data on the EC2 host.
DATA_DIR=/opt/youth-policy-rag/data
WEB_PORT=3000

# Keep false until HTTPS is configured with the reverse proxy.
SESSION_COOKIE_SECURE=false

# Required by the active config.yaml providers.
UPSTAGE_API_KEY=
DEEPSEEK_API_KEY=

# Optional policy collection key.
YOUTH_API_KEY=

# The current API image does not bundle the local LangFeather SDK.
LANGFEATHER_TRACING=false
